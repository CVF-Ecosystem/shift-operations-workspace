  ],
  "$defs":{
    "digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "rawEnvelope":{"type":"object","additionalProperties":false,"required":["version","envelope_id","endpoint_id","channel_id","external_message_id","key_id","nonce_b64","ciphertext_b64","tag_b64","aad_sha256","body_sha256","byte_length","received_at","retention_class"],"properties":{"version":{"const":"1"},"envelope_id":{"type":"string","minLength":1},"endpoint_id":{"type":"string","minLength":1},"channel_id":{"type":"string","minLength":1},"external_message_id":{"type":"string","minLength":1},"key_id":{"type":"string","minLength":1},"nonce_b64":{"type":"string","minLength":16},"ciphertext_b64":{"type":"string","minLength":1},"tag_b64":{"type":"string","minLength":16},"aad_sha256":{"$ref":"#/$defs/digest"},"body_sha256":{"$ref":"#/$defs/digest"},"byte_length":{"type":"integer","minimum":0},"received_at":{"type":"string","format":"date-time"},"retention_class":{"const":"EDGE_RAW_30D"}}},
    "candidateProposal":{"type":"object","additionalProperties":false,"required":["version","proposal_id","raw_envelope_id","content_mode","trust","endpoint_id","channel_id","external_message_id","body_sha256","candidate_sha256","received_at","correlation_id"],"properties":{"version":{"const":"1"},"proposal_id":{"type":"string","minLength":1},"raw_envelope_id":{"type":"string","minLength":1},"content_mode":{"const":"RAW"},"trust":{"const":"UNTRUSTED_EXTERNAL"},"endpoint_id":{"type":"string","minLength":1},"channel_id":{"type":"string","minLength":1},"external_message_id":{"type":"string","minLength":1},"body_sha256":{"$ref":"#/$defs/digest"},"candidate_sha256":{"$ref":"#/$defs/digest"},"received_at":{"type":"string","format":"date-time"},"correlation_id":{"type":"string","minLength":1}}},
    "PREAUTH_REFUSED":{"type":"object","additionalProperties":false,"required":["outcome","reason","preauth_count","postauth_count","route_attempts"],"properties":{"outcome":{"const":"PREAUTH_REFUSED"},"reason":{"enum":["RATE_LIMITED","UNTRUSTED_PEER","OVERSIZED"]},"preauth_count":{"const":1},"postauth_count":{"const":0},"route_attempts":{"const":0}}},
    "AUTH_REFUSED":{"type":"object","additionalProperties":false,"required":["outcome","reason","preauth_count","postauth_count","route_attempts"],"properties":{"outcome":{"const":"AUTH_REFUSED"},"reason":{"enum":["MISSING_SIGNATURE","INVALID_SIGNATURE","STALE_SIGNATURE"]},"preauth_count":{"const":1},"postauth_count":{"const":0},"route_attempts":{"const":0}}},
    "DUPLICATE":{"type":"object","additionalProperties":false,"required":["outcome","raw_envelope_id","preauth_count","postauth_count","route_attempts"],"properties":{"outcome":{"const":"DUPLICATE"},"raw_envelope_id":{"type":"string","minLength":1},"preauth_count":{"const":1},"postauth_count":{"const":1},"route_attempts":{"const":0}}},
    "COLLISION_QUARANTINED":{"type":"object","additionalProperties":false,"required":["outcome","reason","raw_envelope_id","quarantine_id","preauth_count","postauth_count","route_attempts"],"properties":{"outcome":{"const":"COLLISION_QUARANTINED"},"reason":{"const":"KEY_COLLISION"},"raw_envelope_id":{"type":"string","minLength":1},"quarantine_id":{"type":"string","minLength":1},"preauth_count":{"const":1},"postauth_count":{"const":1},"route_attempts":{"const":0}}},
    "POSTAUTH_RATE_REFUSED":{"type":"object","additionalProperties":false,"required":["outcome","reason","raw_envelope_id","preauth_count","postauth_count","route_attempts"],"properties":{"outcome":{"const":"POSTAUTH_RATE_REFUSED"},"reason":{"const":"RATE_LIMITED"},"raw_envelope_id":{"type":"string","minLength":1},"preauth_count":{"const":1},"postauth_count":{"const":1},"route_attempts":{"const":0}}},
    "RESERVATION_CONFLICT":{"type":"object","additionalProperties":false,"required":["outcome","reason","preauth_count","postauth_count","route_attempts"],"properties":{"outcome":{"const":"RESERVATION_CONFLICT"},"reason":{"const":"ACTIVE_RESERVATION"},"preauth_count":{"const":1},"postauth_count":{"const":1},"route_attempts":{"const":0}}},
    "QUARANTINED":{"type":"object","additionalProperties":false,"required":["outcome","reason","raw_envelope_id","quarantine_id","preauth_count","postauth_count","route_attempts"],"properties":{"outcome":{"const":"QUARANTINED"},"reason":{"enum":["MALFORMED_SCHEMA","UNSUPPORTED_TYPE","AMBIGUOUS_CONTENT","UNSAFE_ATTACHMENT","SCAN_UNAVAILABLE","POLICY_DRIFT","ROUTE_POLICY_REFUSED"]},"raw_envelope_id":{"type":"string","minLength":1},"quarantine_id":{"type":"string","minLength":1},"preauth_count":{"const":1},"postauth_count":{"const":1},"route_attempts":{"const":0}}},
    "QUARANTINE_PERSISTENCE_FAILED":{"type":"object","additionalProperties":false,"required":["outcome","reason","raw_envelope_id","preauth_count","postauth_count","route_attempts"],"properties":{"outcome":{"const":"QUARANTINE_PERSISTENCE_FAILED"},"reason":{"const":"QUARANTINE_SINK_UNAVAILABLE"},"raw_envelope_id":{"type":"string","minLength":1},"preauth_count":{"const":1},"postauth_count":{"const":1},"route_attempts":{"const":0}}},
    "ROUTE_REFUSED":{"type":"object","additionalProperties":false,"required":["outcome","reason","raw_envelope_id","preauth_count","postauth_count","route_attempts"],"properties":{"outcome":{"const":"ROUTE_REFUSED"},"reason":{"enum":["DOWNSTREAM_REFUSED","SERVICE_ASSERTION_REFUSED"]},"raw_envelope_id":{"type":"string","minLength":1},"preauth_count":{"const":1},"postauth_count":{"const":1},"route_attempts":{"const":1}}},
    "ROUTED":{"type":"object","additionalProperties":false,"required":["outcome","raw_envelope_id","preauth_count","postauth_count","route_attempts"],"properties":{"outcome":{"const":"ROUTED"},"raw_envelope_id":{"type":"string","minLength":1},"preauth_count":{"const":1},"postauth_count":{"const":1},"route_attempts":{"const":1}}},
    "ROUTE_OUTCOME_UNKNOWN":{"type":"object","additionalProperties":false,"required":["outcome","reason","raw_envelope_id","preauth_count","postauth_count","route_attempts"],"properties":{"outcome":{"const":"ROUTE_OUTCOME_UNKNOWN"},"reason":{"const":"AMBIGUOUS_TRANSPORT"},"raw_envelope_id":{"type":"string","minLength":1},"preauth_count":{"const":1},"postauth_count":{"const":1},"route_attempts":{"const":1}}}
  }
}
