{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://cvf.local/contracts/channel/edge-ingress.schema.json",
  "title":"P4-C closed ingress contracts",
  "oneOf":[
    {"$ref":"#/$defs/rawEnvelope"},{"$ref":"#/$defs/candidateProposal"},
