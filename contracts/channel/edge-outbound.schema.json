{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://cvf.local/contracts/channel/edge-outbound.schema.json","title":"P4-C closed outbound contracts",
  "oneOf":[{"$ref":"#/$defs/outboundCommand"},{"$ref":"#/$defs/NOT_ATTEMPTED"},{"$ref":"#/$defs/SENT_ACCEPTED"},{"$ref":"#/$defs/DELIVERED"},{"$ref":"#/$defs/PROVIDER_REFUSED"},{"$ref":"#/$defs/RATE_LIMITED"},{"$ref":"#/$defs/OUTCOME_UNKNOWN"},{"$ref":"#/$defs/TERMINAL_FAILED"}],
  "$defs":{
    "digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "outboundCommand":{"type":"object","additionalProperties":false,"required":["version","command_id","workspace_digest","record_digest","action_digest","record_version","content_digest","recipient_digest","channel_digest","idempotency_key","policy_version","prerequisite_receipt_refs","correlation_id"],"properties":{"version":{"const":"1"},"command_id":{"type":"string","minLength":1},"workspace_digest":{"$ref":"#/$defs/digest"},"record_digest":{"$ref":"#/$defs/digest"},"action_digest":{"$ref":"#/$defs/digest"},"record_version":{"type":"integer","minimum":1},"content_digest":{"$ref":"#/$defs/digest"},"recipient_digest":{"$ref":"#/$defs/digest"},"channel_digest":{"$ref":"#/$defs/digest"},"idempotency_key":{"type":"string","minLength":1},"policy_version":{"type":"string","minLength":1},"prerequisite_receipt_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"correlation_id":{"type":"string","minLength":1}}},
    "NOT_ATTEMPTED":{"type":"object","additionalProperties":false,"required":["outcome","reason","command_id","delivery_attempts"],"properties":{"outcome":{"const":"NOT_ATTEMPTED"},"reason":{"enum":["AUTH_REFUSED","PREREQUISITE_REFUSED","ADAPTER_UNAVAILABLE"]},"command_id":{"type":"string","minLength":1},"delivery_attempts":{"const":0}}},
    "SENT_ACCEPTED":{"type":"object","additionalProperties":false,"required":["outcome","command_id","delivery_id","delivery_attempts"],"properties":{"outcome":{"const":"SENT_ACCEPTED"},"command_id":{"type":"string","minLength":1},"delivery_id":{"type":"string","minLength":1},"delivery_attempts":{"const":1}}},
    "DELIVERED":{"type":"object","additionalProperties":false,"required":["outcome","command_id","delivery_id","delivery_attempts"],"properties":{"outcome":{"const":"DELIVERED"},"command_id":{"type":"string","minLength":1},"delivery_id":{"type":"string","minLength":1},"delivery_attempts":{"const":1}}},
    "PROVIDER_REFUSED":{"type":"object","additionalProperties":false,"required":["outcome","reason","command_id","delivery_attempts"],"properties":{"outcome":{"const":"PROVIDER_REFUSED"},"reason":{"const":"PROVIDER_REFUSED"},"command_id":{"type":"string","minLength":1},"delivery_attempts":{"const":1}}},
    "RATE_LIMITED":{"type":"object","additionalProperties":false,"required":["outcome","reason","command_id","delivery_attempts"],"properties":{"outcome":{"const":"RATE_LIMITED"},"reason":{"const":"RATE_LIMITED"},"command_id":{"type":"string","minLength":1},"delivery_attempts":{"const":0}}},
    "OUTCOME_UNKNOWN":{"type":"object","additionalProperties":false,"required":["outcome","reason","command_id","delivery_attempts"],"properties":{"outcome":{"const":"OUTCOME_UNKNOWN"},"reason":{"const":"AMBIGUOUS_TRANSPORT"},"command_id":{"type":"string","minLength":1},"delivery_attempts":{"const":1}}},
    "TERMINAL_FAILED":{"type":"object","additionalProperties":false,"required":["outcome","reason","command_id","delivery_attempts"],"properties":{"outcome":{"const":"TERMINAL_FAILED"},"reason":{"enum":["INVALID_RESPONSE","NONRETRYABLE_ERROR"]},"command_id":{"type":"string","minLength":1},"delivery_attempts":{"const":1}}}
  }
}
