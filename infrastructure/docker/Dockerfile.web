FROM node:22.14.0-alpine3.21 AS build
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY apps/workspace-web/package.json apps/workspace-web/package.json
RUN pnpm install --frozen-lockfile
COPY apps/workspace-web/tsconfig.json apps/workspace-web/vite.config.ts apps/workspace-web/index.html apps/workspace-web/
COPY apps/workspace-web/src apps/workspace-web/src
COPY apps/workspace-web/public apps/workspace-web/public
RUN pnpm --filter workspace-web build
FROM nginx:1.27-alpine
COPY --from=build /app/apps/workspace-web/dist /usr/share/nginx/html
