{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "customer-request.schema",
  "type": "object",
  "required": [
    "request_id",
    "customer_id",
    "summary",
    "status",
    "received_at"
  ],
  "properties": {
    "request_id": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["NEW", "ACKNOWLEDGED", "IN_PROGRESS", "WAITING", "RESOLVED", "CLOSED"]
    },
    "received_at": {
      "type": "string"
    },
    "shift_id": {
      "type": ["string", "null"]
    },
    "details": {
      "type": ["string", "null"]
    },
    "source_message_id": {
      "type": ["string", "null"]
    },
    "promised_at": {
      "type": ["string", "null"]
    },
    "owner_id": {
      "type": ["string", "null"]
    }
  }
}
