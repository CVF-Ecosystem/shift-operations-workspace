{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "incident.schema",
  "type": "object",
  "required": [
    "incident_id",
    "shift_id",
    "risk_class",
    "summary",
    "status"
  ],
  "properties": {
    "incident_id": {
      "type": "string"
    },
    "shift_id": {
      "type": "string"
    },
    "risk_class": {
      "type": "string",
      "enum": ["R0", "R1", "R2", "R3", "R4"]
    },
    "summary": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["REPORTED", "ACKNOWLEDGED", "MITIGATING", "RESOLVED", "CLOSED"]
    }
  }
}
